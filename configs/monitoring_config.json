{
  "metrics": {
    "prediction_latency_ms": {
      "type": "histogram",
      "buckets": [
        10,
        50,
        100,
        200,
        500
      ]
    },
    "prediction_confidence": {
      "type": "histogram",
      "buckets": [
        0.1,
        0.3,
        0.5,
        0.7,
        0.9
      ]
    },
    "ct_tox_positive_rate": {
      "type": "counter"
    },
    "input_smiles_validity": {
      "type": "counter"
    }
  },
  "alerting": {
    "high_latency_threshold_ms": 500,
    "low_confidence_threshold": 0.5,
    "error_rate_threshold": 0.05
  }
}